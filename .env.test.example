# Test Environment — Docker Postgres
#
# Copy this file to .env.test and fill in values.
# DO NOT commit .env.test.
#
# When using the Docker Postgres container (docker compose up -d):

# ── Test database (shared integration tests) ─────────────────────────────────
# Owner URL — used by the pretest migration script
MIGRATION_DATABASE_URL=postgresql://aceowner:aceowner@localhost:5433/acetest

# App URL — used by the test suite (read as DATABASE_URL by setup.ts)
TEST_DATABASE_URL=postgresql://aceowner:aceowner@localhost:5433/acetest
DATABASE_URL_TEST=postgresql://aceowner:aceowner@localhost:5433/acetest

# Migration throwaway database (schema reproducibility test only)
MIGRATION_TEST_DB_URL=postgresql://aceowner:aceowner@localhost:5433/acemigrationtest

# ── Application secrets (safe local-only values) ─────────────────────────────
AUTH_SECRET=local-test-auth-secret-change-in-production
AUTH_URL=http://localhost:3000
APP_ENV=test
ADMIN_SEED_PASSWORD=TestAdmin1!

