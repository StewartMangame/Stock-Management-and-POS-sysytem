# ==============================================================================
# Ace Holdings Stock Management & POS System — Environment Configuration
# ==============================================================================
# Variables marked [SECRET] contain sensitive credentials and MUST NEVER be 
# committed to git, exposed to client bundles, or prefixed with NEXT_PUBLIC_.
# ==============================================================================

# ── 1. Application Environment ────────────────────────────────────────────────
# Required: 'local' | 'test' | 'staging' | 'production'.
# The application refuses to start in deployed environments if this is missing.
APP_ENV="local"

# ── 2. Database ───────────────────────────────────────────────────────────────
# [SECRET] Runtime application database URL (Neon pooled endpoint via WebSocket).
# MUST connect as restricted runtime role 'ace_app_user' (no DDL, append-only journals).
# Set in Vercel environment variables and local .env.
# Format: postgresql://ace_app_user:PASSWORD@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://ace_app_user:PASSWORD@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"

# [SECRET] Migration database URL (Neon direct/unpooled endpoint).
# MUST connect as owner role (e.g. 'neondb_owner').
# Used ONLY from local developer terminal or CI for 'npm run db:migrate'.
# ⚠️ NEVER SET THIS VARIABLE IN VERCEL.
# Format: postgresql://neondb_owner:PASSWORD@ep-xyz.region.neon.tech/neondb?sslmode=require
MIGRATION_DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xyz.region.neon.tech/neondb?sslmode=require"

# Comma-separated list of database hostnames protected against destructive wipes
# (clear-demo-data, reset-admin, etc. will refuse to run on these hosts).
PROTECTED_DB_HOSTS="ep-xyz.region.neon.tech,ep-xyz-pooler.region.neon.tech"

# ── 3. Authentication ─────────────────────────────────────────────────────────
# [SECRET] Auth.js secret key (generate with: openssl rand -base64 32)
AUTH_SECRET="generate-32-byte-base64-secret"

# Canonical public deployment URL (used for callback redirects)
# e.g. https://pos.ace.co.mw or https://your-project.vercel.app
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── 4. Scheduled Jobs & Health Check ──────────────────────────────────────────
# [SECRET] Shared token sent by Vercel Cron as 'Authorization: Bearer <CRON_SECRET>'.
# Used to authenticate GET /api/cron/* routes in constant time.
CRON_SECRET="generate-strong-cron-secret-token"

# [SECRET] Secret header token for GET /api/health/db (x-health-check-secret).
HEALTH_CHECK_SECRET="generate-strong-health-secret-token"

# ── 5. Payment Gateway (OneKhusa) ─────────────────────────────────────────────
# Set to 'mock' for local/staging development; 'live' for real payment processing.
# ⚠️ NOTE: APP_ENV=production strictly REFUSES 'mock' mode.
ONEKHUSA_MODE="mock"

# Base REST API URL (sandbox: https://api.onekhusa.com/sandbox/v1, prod: https://api.onekhusa.com/v1)
ONEKHUSA_BASE_URL="https://api.onekhusa.com/sandbox/v1"

# [SECRET] OneKhusa API Credentials
ONEKHUSA_API_KEY=""
ONEKHUSA_API_SECRET=""
ONEKHUSA_ORGANISATION_ID=""
ONEKHUSA_MERCHANT_ACCOUNT_NUMBER=""

# [SECRET] Webhook signature verification secret
ONEKHUSA_WEBHOOK_SECRET=""

# ── 6. Electronic Invoicing System (MRA EIS) ──────────────────────────────────
# Disabled by default. APP_ENV=production strictly REFUSES mock EIS adapter.
EIS_ENABLED="false"
EIS_BASE_URL=""
# [SECRET]
EIS_API_KEY=""

# ── 7. Cloudflare Turnstile Bot Protection ────────────────────────────────────
# [PUBLIC] Client-side sitekey for Turnstile widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# [SECRET] Cloudflare Turnstile secret key for server token verification
TURNSTILE_SECRET_KEY=""

# ── 8. Initial Seed (Local / CI Only) ─────────────────────────────────────────
# [SECRET] Password for the seeded administrator account (admin@ace.co.mw).
# Admin is flagged with forcePasswordChange=true on initial creation.
ADMIN_SEED_PASSWORD="ChangeMe123!"

# ── 9. Isolated Test Database (Tests & CI Only) ───────────────────────────────
# [SECRET] Dedicated database URL for running integration tests.
# The test guard prohibits tests from running if this equals DATABASE_URL.
DATABASE_URL_TEST="postgresql://user:pass@localhost:5432/ace_test?sslmode=disable"
