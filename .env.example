# ── Application ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon WebSocket pool — must support transactions)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://..."

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Application URL (used by Auth.js for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ── Seed ─────────────────────────────────────────────────────────────────────

# Password for the initial admin user created by the seed script.
# The admin is forced to change this on first login.
ADMIN_SEED_PASSWORD="ChangeMe123!"

# ── External services (leave blank to use built-in mocks) ────────────────────

# OneKhusa payment gateway
ONEKHUSA_API_KEY=""
ONEKHUSA_API_SECRET=""
ONEKHUSA_BASE_URL="https://sandbox.onekhusa.com"

# MRA EIS (Electronic Invoicing System) — set eis_enabled=true in Settings
EIS_BASE_URL=""
EIS_API_KEY=""

# ── Feature flags ─────────────────────────────────────────────────────────────

# Set to "true" to enable EIS submission (requires EIS credentials above)
EIS_ENABLED="false"

# ── Test database (only needed for integration tests) ────────────────────────

# Separate DB for migration + seed integration tests
DATABASE_URL_TEST="postgresql://..."
